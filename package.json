    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "openai": "^6.49.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20 <23"
  }
