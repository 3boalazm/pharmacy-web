{
  "name": "pharmacy-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "secrets": "node scripts/check-secrets.mjs",
    "audit:prod": "node scripts/audit-gate.mjs",
    "test:contract": "vitest run tests/contract",
    "verify:deploy": "node scripts/verify-deployment.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run boundaries && npm run secrets && npm run audit:prod && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
