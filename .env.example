# ── الواجهة (Next.js) ────────────────────────────────────────────────────────
# عنوان الـ API كما يراه المتصفح:
#   • اتركه فارغًا/غير معرّف  → الواجهة تستدعي "/api/v1" من نفس الأصل،
#     ويجب أن يكون API_PROXY_TARGET مضبوطًا وقت البناء ليعمل الـ rewrite.
#   • أو ضع رابطًا كاملًا (https://api.example.com/api/v1) وأضِفه إلى CORS في الخادم؛
#     سيُضاف أصله تلقائيًا إلى connect-src في CSP عبر next.config.mjs.
NEXT_PUBLIC_API_BASE_URL=

# هدف الـ proxy المحلي/وقت البناء (لا يُرسل للمتصفح). مثال: http://localhost:3000
API_PROXY_TARGET=

# ── افتراضات عقد لم تُثبت من الواجهة ─────────────────────────────────────────
# تجديد الجلسة: POST /auth/refresh  { refreshToken, deviceId }
#            → { data: { accessToken, refreshToken? } }
# إن لم يطبّقه الخادم: 401 يعيد المستخدم إلى /login مع returnTo (السلوك السابق).

# ── مراقبة وأمان (اختياري لكنه مُوصى به) ───────────────────────────────────
# نقطة تجميع تقارير الأخطاء (تُرسل حقول محدودة فقط، بلا بيانات عملاء/مبالغ/توكنات)
NEXT_PUBLIC_ERROR_ENDPOINT=

# تجميع انتهاكات CSP قبل تشديد السياسة (report-uri + Reporting-Endpoints)
CSP_REPORT_URI=

# معرّف إصدار البناء لتمييز التقارير (commit SHA أو رقم إصدار)
NEXT_PUBLIC_BUILD_ID=
